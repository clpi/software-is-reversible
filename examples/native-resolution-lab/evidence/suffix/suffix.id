validchild: i64 = (arena: *i64, child: i64, node: i64, depth: i64)
    if child < -1
        return 0
    if child >= node
        return 0
    if depth == 1
        if child != 0
            return 0
    if child > 0
        previous = ((child - 1) * 4) + 1
        if arena[previous] != depth - 1
            return 0
    1

page: i64 = (arena: *i64, nodes: i64, root: i64, horizon: i64, start: i64, limit: i64)
    if nodes < 1
        return -1
    if nodes > 128
        return -1
    if root < 1
        return -1
    if root > nodes
        return -1
    if horizon < 1
        return -1
    if horizon > 30
        return -1
    if start < 0
        return -1
    if start > 1073741823
        return -1
    if limit < 0
        return -1
    if limit > 32
        return -1
    if limit == 0
        if start != 0
            return -1
    rootentry = ((root - 1) * 4) + 1
    if arena[rootentry] != horizon
        return -1
    node = 1
    while node <= nodes
        base = ((node - 1) * 4) + 1
        depth = arena[base]
        zero = arena[base + 1]
        one = arena[base + 2]
        eos = arena[base + 3]
        if depth < 1
            return -1
        if depth > horizon
            return -1
        if eos < -1
            return -1
        if eos > 1
            return -1
        if validchild(arena, zero, node, depth) == 0
            return -1
        if validchild(arena, one, node, depth) == 0
            return -1
        node = node + 1
    counts = nodes * 4
    header = nodes * 6
    node = 1
    while node <= nodes
        base = ((node - 1) * 4) + 1
        depth = arena[base]
        zero = arena[base + 1]
        one = arena[base + 2]
        eos = arena[base + 3]
        low = 0
        high = 0
        if eos == 1
            low = 1
        if eos != 0
            high = 1
        if zero == -1
            high = high + ((1 << (depth - 1)) - 1)
        if zero > 0
            entry = counts + ((zero - 1) * 2) + 1
            low = low + arena[entry]
            high = high + arena[entry + 1]
        if one == -1
            high = high + ((1 << (depth - 1)) - 1)
        if one > 0
            entry = counts + ((one - 1) * 2) + 1
            low = low + arena[entry]
            high = high + arena[entry + 1]
        entry = counts + ((node - 1) * 2) + 1
        arena[entry] = low
        arena[entry + 1] = high
        node = node + 1
    entry = counts + ((root - 1) * 2) + 1
    low = arena[entry]
    high = arena[entry + 1]
    arena[header + 1] = low
    arena[header + 2] = high
    if limit == 0
        return 0
    if low != high
        return -2
    if start > low
        return -3
    count = 0
    while count < limit
        if start + count >= low
            return count
        rank = start + count
        at = root
        code = 1
        done = 0
        while done == 0
            base = ((at - 1) * 4) + 1
            zero = arena[base + 1]
            one = arena[base + 2]
            zcount = 0
            ocount = 0
            if zero > 0
                atcount = counts + ((zero - 1) * 2) + 1
                zcount = arena[atcount]
            if one > 0
                atcount = counts + ((one - 1) * 2) + 1
                ocount = arena[atcount]
            if rank < zcount
                at = zero
                code = code * 2
            else
                rank = rank - zcount
                if rank < ocount
                    at = one
                    code = code * 2 + 1
                else
                    done = 1
        arena[header + 3 + count] = code
        count = count + 1
    count
