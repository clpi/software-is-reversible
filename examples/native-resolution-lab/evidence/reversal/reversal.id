length: i64 = (plan: i64)
    if plan < 1 or plan > 255
        return -1
    left: i64 = plan
    count: i64 = 0
    while left > 0
        if left % 4 == 0
            return -1
        count = count + 1
        left = left // 4
    count

allows: i64 = (caps: i64, action: i64)
    place: i64 = 1
    if action == 2
        place = 2
    else if action == 3
        place = 4
    else if action == 4
        place = 8
    caps // place % 2

flip: i64 = (value: i64)
    value + 1 - 2 * (value % 2)

rotate: i64 = (value: i64)
    (2 * value) % 8 + value // 4

unrotate: i64 = (value: i64)
    value // 2 + 4 * (value % 2)

prepare: i64 = (expected: i64, observed: i64, plan: i64, caps: i64)
    count: i64 = length(plan)
    if expected < 0 or expected > 1023 or observed < 0 or observed > 1023 or caps < 0 or caps > 15 or count < 0
        return -1
    if expected != observed
        return -2
    epoch: i64 = observed // 8
    if epoch + count > 127
        return -7
    value: i64 = observed % 8
    left: i64 = plan
    residual: i64 = 0
    place: i64 = 1
    while left > 0
        action: i64 = left % 4
        if allows(caps, action) == 0
            return -3
        if action == 1
            value = flip(value)
        else if action == 2
            residual = residual + place * (value + 1)
            value = 0
        else
            value = rotate(value)
        place = place * 9
        left = left // 4
    plan + 256 * (residual + 6561 * (value + 8 * epoch))

predicted: i64 = (receipt: i64)
    if receipt < 0 or receipt >= 1719926784
        return -1
    count: i64 = length(receipt % 256)
    if count < 0
        return -1
    upper: i64 = receipt // 1679616
    epoch: i64 = upper // 8
    if epoch + count > 127
        return -7
    8 * (epoch + count) + upper % 8

predecessor: i64 = (receipt: i64)
    after: i64 = predicted(receipt)
    if after < 0
        return after
    plan: i64 = receipt % 256
    remaining: i64 = receipt // 256 % 6561
    code: i64 = 1
    place: i64 = 1
    count: i64 = length(plan)
    index: i64 = 1
    while index < count
        code = code * 4
        place = place * 9
        index = index + 1
    if remaining // (9 * place) != 0
        return -5
    value: i64 = after % 8
    while code > 0
        action: i64 = plan // code % 4
        cell: i64 = remaining // place % 9
        if action == 2
            if cell == 0
                return -4
            if value != 0
                return -5
            value = cell - 1
        else
            if cell != 0
                return -5
            if action == 1
                value = flip(value)
            else
                value = unrotate(value)
        code = code // 4
        place = place // 9
    8 * (after // 8 - count) + value

advance: i64 = (receipt: i64, retained: i64, fresh: i64, caps: i64)
    before: i64 = predecessor(receipt)
    if before < 0
        return before
    if receipt != retained
        return -6
    if fresh < 0 or fresh > 1023 or caps < 0 or caps > 15
        return -1
    if fresh != before
        return -2
    expected: i64 = prepare(before, fresh, receipt % 256, caps)
    if expected < 0
        return expected
    if expected != receipt
        return -6
    predicted(receipt)

verify: i64 = (receipt: i64, retained: i64, fresh: i64)
    before: i64 = predecessor(receipt)
    if before < 0
        return before
    if receipt != retained
        return -6
    if fresh < 0 or fresh > 1023
        return -1
    after: i64 = predicted(receipt)
    if fresh != after
        return -2
    after

inverse: i64 = (receipt: i64, retained: i64, fresh: i64, caps: i64)
    before: i64 = predecessor(receipt)
    if before < 0
        return before
    if receipt != retained
        return -6
    if fresh < 0 or fresh > 1023 or caps < 0 or caps > 15
        return -1
    after: i64 = predicted(receipt)
    if fresh != after
        return -2
    left: i64 = receipt % 256
    epoch: i64 = after // 8 + length(left)
    if epoch > 127
        return -7
    while left > 0
        action: i64 = left % 4
        if action == 2
            if allows(caps, 4) == 0
                return -3
        else if allows(caps, action) == 0
            return -3
        left = left // 4
    8 * epoch + before % 8

undoverify: i64 = (receipt: i64, retained: i64, prior: i64, fresh: i64, caps: i64)
    target: i64 = inverse(receipt, retained, prior, caps)
    if target < 0
        return target
    if fresh < 0 or fresh > 1023
        return -1
    if fresh != target
        return -2
    target
